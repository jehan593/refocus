{
  "manifest_version": 3,
  "name": "Refocus",
  "version": "1.0.0",
  "description": "Hide distracting clutter on the sites you choose.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Refocus",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*",
        "*://music.youtube.com/*",
        "*://*.music.youtube.com/*",
        "*://open.spotify.com/*",
        "*://web.whatsapp.com/*",
        "*://*.web.whatsapp.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
